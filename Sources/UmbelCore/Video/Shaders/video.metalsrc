#include <metal_stdlib>
using namespace metal;

struct VertexOut {
  float4 position [[position]];
  float2 uv;
};

struct ColorUniforms {
  // Offsets and scales for luma and chroma; limited and full range differ.
  float lumaOffset;
  float lumaScale;
  float chromaOffset;
  float chromaScale;
  // Each channel is luma plus x × Cb plus y × Cr: the Y′CbCr matrix, from
  // BT.601, BT.709 or BT.2020's luma weights.
  float4 red;
  float4 green;
  float4 blue;
  // 0 none; 1 PQ and 2 HLG tone-mapped to standard range, from the film's
  // peak to SDR white, both in nits.
  int toneMap;
  float sourcePeak;
  float targetPeak;
  // For an HDR target: 1 PQ to linear light at 100 nits a unit, 2 HLG to
  // scene light 0...12; the system tone-maps both with the layer's EDR
  // metadata.
  int linearOutput;
  int sourceTransfer;
  int inputRGB;
  int convertGamut;
  int ditherOutput;
  float2 chromaScaleUV;
  float2 chromaOffsetUV;
  float4 gamutRed;
  float4 gamutGreen;
  float4 gamutBlue;
  float4 adjustments;
  float4 luminanceWeights;
};

// ── HDR to standard range ─────────────────────────────────
// BT.2100's PQ and HLG, BT.2390's EETF, BT.2087's primaries, BT.1886.

constant float pqM1 = 2610.0 / 16384.0, pqM2 = 2523.0 / 4096.0 * 128.0;
constant float pqC1 = 3424.0 / 4096.0, pqC2 = 2413.0 / 4096.0 * 32.0, pqC3 = 2392.0 / 4096.0 * 32.0;

static float pqEncode(float nits) {
  float p = pow(max(nits, 0.0) / 10000.0, pqM1);
  return pow((pqC1 + pqC2 * p) / (1.0 + pqC3 * p), pqM2);
}

static float pqDecode(float e) {
  float p = pow(max(e, 0.0), 1.0 / pqM2);
  return 10000.0 * pow(max(p - pqC1, 0.0) / (pqC2 - pqC3 * p), 1.0 / pqM1);
}

/// HLG signal to scene light 0...1: BT.2100's inverse OETF.
static float3 hlgToScene(float3 v) {
  const float a = 0.17883277, b = 0.28466892, c = 0.55991073;
  return select((exp((v - c) / a) + b) / 12.0, v * v / 3.0, v <= 0.5);
}

/// HLG signal to display light in nits: the inverse OETF, then the OOTF
/// with system gamma 1.2 for a display of `peak` nits.
static float3 hlgToDisplay(float3 v, float peak) {
  float3 scene = hlgToScene(v);
  float luminance = dot(float3(0.2627, 0.6780, 0.0593), scene);
  return peak * pow(max(luminance, 1e-6), 0.2) * scene;
}

/// BT.2390's EETF: below the knee untouched, above it bent smoothly so the
/// source peak lands on the target peak. In PQ's perceptual scale.
static float eetf(float nits, float sourcePeak, float targetPeak) {
  float source = pqEncode(sourcePeak);
  float e1 = clamp(pqEncode(nits) / source, 0.0, 1.0);
  float maxLum = pqEncode(targetPeak) / source;
  float knee = max(1.5 * maxLum - 0.5, 0.0);
  float e2 = e1;
  if (e1 >= knee && knee < 1.0) {
    float t = (e1 - knee) / (1.0 - knee);
    float t2 = t * t, t3 = t2 * t;
    e2 = (2.0 * t3 - 3.0 * t2 + 1.0) * knee + (t3 - 2.0 * t2 + t) * (1.0 - knee)
       + (-2.0 * t3 + 3.0 * t2) * maxLum;
  }
  return pqDecode(e2 * source);
}

/// BT.2020 to BT.709 primaries, in linear light (BT.2087's inverse).
constant float3x3 bt2020ToBt709 = float3x3(
  float3(1.6605, -0.1246, -0.0182),
  float3(-0.5876, 1.1329, -0.1006),
  float3(-0.0728, -0.0083, 1.1187));

static float3 convertPrimaries(float3 rgb, constant ColorUniforms &u) {
  if (u.convertGamut == 0) { return rgb; }
  return float3(dot(u.gamutRed.xyz, rgb), dot(u.gamutGreen.xyz, rgb), dot(u.gamutBlue.xyz, rgb));
}

static float3 decodeSDR(float3 rgb, int transfer) {
  if (transfer == 8) { return rgb; }
  rgb = max(rgb, 0.0);
  if (transfer == 13) { return select(pow((rgb + 0.055) / 1.055, 2.4), rgb / 12.92, rgb <= 0.04045); }
  if (transfer == 4) { return pow(rgb, 2.2); }
  if (transfer == 5) { return pow(rgb, 2.8); }
  if (transfer == 7) { return select(pow((rgb + 0.1115) / 1.1115, 1.0 / 0.45), rgb / 4.0, rgb < 0.0912); }
  if (transfer == 9 || transfer == 10) { return select(pow(10.0, (rgb - 1.0) * (transfer == 9 ? 2.0 : 2.5)), float3(0), rgb == 0); }
  if (transfer == 15) {
    return select(pow((rgb + 0.0992968268) / 1.0992968268, 1.0 / 0.45), rgb / 4.5, rgb < 0.0812428583);
  }
  return select(pow((rgb + 0.099) / 1.099, 1.0 / 0.45), rgb / 4.5, rgb < 0.081);
}

static float exportDither(float2 position) {
  uint2 pixel = uint2(position);
  uint rank = 0;
  for (uint bit = 0; bit < 3; ++bit) {
    uint x = (pixel.x >> bit) & 1, y = (pixel.y >> bit) & 1;
    rank = (rank << 2) | ((x ^ y) << 1) | y;
  }
  return ((float(rank) + 0.5) / 64.0 - 0.5) / 255.0;
}

/// To light, the brightest channel through the EETF with the others scaled
/// alike so hues hold, then into BT.709 with what falls outside clipped,
/// encoded as BT.1886 expects.
static float3 toneMapToStandard(float3 rgb, constant ColorUniforms &uniforms) {
  float3 light = uniforms.toneMap == 1
    ? float3(pqDecode(rgb.r), pqDecode(rgb.g), pqDecode(rgb.b))
    : hlgToDisplay(rgb, 1000.0);
  light = convertPrimaries(light, uniforms);
  float peak = max(max(light.r, light.g), light.b);
  if (peak > 0.0) { light *= eetf(peak, uniforms.sourcePeak, uniforms.targetPeak) / peak; }
  float3 relative = bt2020ToBt709 * (light / uniforms.targetPeak);
  return pow(saturate(relative), 1.0 / 2.4);
}

/// A full-screen triangle strip. No vertex buffer: vertices follow from the id.
///
/// `turns` is the picture's clockwise quarter turns to be shown upright:
/// 0, 1, 2 or 3. Seen from the screen position (0...1, top left at the
/// origin), the stored picture is read at:
///   0 → (x, y)   1 → (y, 1 - x)   2 → (1 - x, 1 - y)   3 → (1 - y, x)
/// so a quarter turn clockwise puts the stored top-left corner top-right.
vertex VertexOut umbelVertex(uint id [[vertex_id]], constant uint &turns [[buffer(0)]]) {
  const float2 corners[4] = { float2(-1, -1), float2(1, -1), float2(-1, 1), float2(1, 1) };
  // Texture coordinates start at the top left, clip space at the centre with
  // y up, so y flips.
  float2 screen = float2((corners[id].x + 1) * 0.5, 1.0 - (corners[id].y + 1) * 0.5);
  float2 uv;
  switch (turns) {
    case 1: uv = float2(screen.y, 1.0 - screen.x); break;
    case 2: uv = float2(1.0 - screen.x, 1.0 - screen.y); break;
    case 3: uv = float2(1.0 - screen.y, screen.x); break;
    default: uv = screen; break;
  }
  VertexOut out;
  out.position = float4(corners[id], 0, 1);
  out.uv = uv;
  return out;
}

/// Y′CbCr → R′G′B′ by the frame's own matrix. Two planes in: luma in one
/// texture, chroma in the other (Cb and Cr interleaved).
fragment float4 umbelFragment(VertexOut in [[stage_in]],
                              texture2d<float> lumaTexture [[texture(0)]],
                              texture2d<float> chromaTexture [[texture(1)]],
                              constant ColorUniforms &uniforms [[buffer(0)]]) {
  constexpr sampler linearSampler(filter::linear, address::clamp_to_edge);

  float y = lumaTexture.sample(linearSampler, in.uv).r;
  float2 cbcr = chromaTexture.sample(linearSampler, in.uv * uniforms.chromaScaleUV + uniforms.chromaOffsetUV).rg;

  y = (y - uniforms.lumaOffset) * uniforms.lumaScale;
  float2 c = (cbcr - uniforms.chromaOffset) * uniforms.chromaScale;

  float3 rgb = float3(
    y + dot(uniforms.red.xy, c),
    y + dot(uniforms.green.xy, c),
    y + dot(uniforms.blue.xy, c)
  );
  if (uniforms.inputRGB != 0) { rgb = lumaTexture.sample(linearSampler, in.uv).rgb; }
  if (uniforms.sourceTransfer != 8) { rgb = saturate(rgb); }
  if (uniforms.toneMap != 0) { rgb = toneMapToStandard(rgb, uniforms); }
  if (uniforms.linearOutput == 1) {
    rgb = float3(pqDecode(rgb.r), pqDecode(rgb.g), pqDecode(rgb.b)) / 100.0;
    rgb = convertPrimaries(rgb, uniforms);
  } else if (uniforms.linearOutput == 2) {
    // The system's HLG metadata takes scene light 0...12, as ARIB STD-B67
    // scales it, not BT.2100's 0...1: given 0...1 it shows the picture
    // about three and a half times too dark.
    rgb = hlgToScene(rgb) * 12.0;
    rgb = convertPrimaries(rgb, uniforms);
  }
  // SDR adjustments use the same signal domain for high precision and
  // compatible outputs. Decode afterwards so snapshots agree with playback.
  float4 a = uniforms.adjustments;
  if (a.x != 0.0 || a.y != 1.0 || a.z != 1.0) {
    rgb = (rgb - 0.5 * a.w) * a.y + (0.5 + a.x) * a.w;
    float luminance = dot(rgb, uniforms.luminanceWeights.xyz);
    rgb = mix(float3(luminance), rgb, a.z);
    rgb = uniforms.linearOutput == 0 || uniforms.linearOutput == 3 || uniforms.linearOutput == 4 ? saturate(rgb) : max(rgb, 0.0);
  }
  if (uniforms.linearOutput == 3) {
    if (uniforms.toneMap != 0) {
      rgb = pow(rgb, 2.4);
    } else { rgb = convertPrimaries(decodeSDR(rgb, uniforms.sourceTransfer), uniforms); }
  } else if (uniforms.linearOutput == 4) {
    float3 light = uniforms.toneMap != 0 ? pow(rgb, 2.4)
      : convertPrimaries(decodeSDR(rgb, uniforms.sourceTransfer), uniforms);
    light = max(light, 0.0);
    rgb = select(1.055 * pow(light, 1.0 / 2.4) - 0.055, light * 12.92, light <= 0.0031308);
  } else if (uniforms.linearOutput == 0 && uniforms.toneMap == 0 &&
             (uniforms.convertGamut != 0 || (uniforms.sourceTransfer != 0 && uniforms.sourceTransfer != 1 &&
              uniforms.sourceTransfer != 2 && uniforms.sourceTransfer != 6 && uniforms.sourceTransfer != 14))) {
    float3 linear = max(convertPrimaries(decodeSDR(rgb, uniforms.sourceTransfer), uniforms), 0.0);
    rgb = select(1.099 * pow(linear, 0.45) - 0.099, linear * 4.5, linear < 0.018);
  }
  if (uniforms.ditherOutput != 0) {
    // Construct an 8x8 ordered rank from pixel coordinates. Static in time,
    // zero mean, and bounded to half a destination code on either side.
    rgb += exportDither(in.position.xy);
  }
  return float4(rgb, 1.0);
}

fragment float4 umbelExport(VertexOut in [[stage_in]],
                            texture2d<float> composition [[texture(0)]],
                            constant int &encoding [[buffer(0)]]) {
  constexpr sampler sample(filter::nearest, address::clamp_to_edge);
  float3 light = composition.sample(sample, in.uv).rgb;
  if (encoding == 5) { light = decodeSDR(light, 1); }
  else if (encoding == 0) { light = decodeSDR(light, 13); }
  else if (encoding == 4) { light = bt2020ToBt709 * light; }
  light = max(light, 0.0);
  float3 rgb = select(1.055 * pow(light, 1.0 / 2.4) - 0.055, light * 12.92, light <= 0.0031308);
  return float4(rgb + exportDither(in.position.xy), 1.0);
}
